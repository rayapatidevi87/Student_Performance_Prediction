import os
import json
import warnings
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import (
    train_test_split, cross_val_score, StratifiedKFold
)
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import (
    accuracy_score, precision_score, recall_score,
    f1_score, confusion_matrix, classification_report
)

warnings.filterwarnings("ignore")

# 1. Basic settings
sns.set_theme(style="whitegrid")
NAVY, BLUE, ORANGE = "#1F3A6E", "#3C78C3", "#E07B39"

os.makedirs("figures", exist_ok=True)
RESULTS = {}

# 2. Load dataset
df = pd.read_csv("student-mat.csv", sep=";")

print("Dataset loaded successfully")
print("Dataset shape:", df.shape)
print(df.head())

required = [
    "age", "studytime", "failures", "absences",
    "G1", "G2", "G3", "famsup", "schoolsup",
    "higher", "Medu", "Fedu", "goout", "Walc",
    "health", "school", "sex", "internet"
]

missing_cols = [c for c in required if c not in df.columns]

if missing_cols:
    raise ValueError(f"Missing dataset columns: {missing_cols}")

# 3. Dataset information
print("\nColumn names:")
print(list(df.columns))

print("\nData types:")
print(df.dtypes.value_counts())

print("\nSummary statistics:")
print(df[["age", "studytime", "failures",
          "absences", "G1", "G2", "G3"]].describe())

print("\nFinal grade statistics:")
print("Minimum:", df["G3"].min())
print("Maximum:", df["G3"].max())
print("Mean:", round(df["G3"].mean(), 2))
print("Median:", df["G3"].median())

# 4. Handle missing values
print("\nMissing values:", df.isnull().sum().sum())

for col in df.columns:
    if df[col].isnull().any():
        if pd.api.types.is_numeric_dtype(df[col]):
            df[col] = df[col].fillna(df[col].median())
        else:
            df[col] = df[col].fillna(df[col].mode()[0])

print("Missing values handled.")

# Remove duplicate records
df = df.drop_duplicates().copy()
print("Dataset shape after removing duplicates:", df.shape)

# 5. Create target variable
# 0 = Pass, 1 = Needs Support

df["result"] = np.where(df["G3"] >= 10, "Pass", "Needs Support")
df["target"] = (df["G3"] < 10).astype(int)

print("\nClass distribution:")
print(df["result"].value_counts())

print("\nClass percentage:")
print((df["result"].value_counts(normalize=True) * 100).round(2))

# 6. Exploratory Data Analysis

# 6.1 Grade distribution
plt.figure(figsize=(7, 4))
sns.histplot(df["G3"], bins=21, kde=True, color=BLUE)

plt.axvline(10, color=ORANGE, linestyle="--",
            label="Pass mark = 10")

plt.title("Student Final Grade Distribution")
plt.xlabel("Final Grade")
plt.ylabel("Number of Students")
plt.legend()
plt.tight_layout()
plt.savefig("figures/grade_distribution.png", dpi=200)
plt.close()

# 6.2 Study time vs grades
plt.figure(figsize=(7, 4))
sns.boxplot(x="studytime", y="G3", data=df, color=BLUE)

plt.title("Study Time vs Final Grade")
plt.xlabel("Study Time")
plt.ylabel("Final Grade")
plt.tight_layout()
plt.savefig("figures/studytime_vs_grade.png", dpi=200)
plt.close()

# 6.3 Absences vs grades
plt.figure(figsize=(7, 4))
sns.regplot(
    x="absences", y="G3", data=df,
    scatter_kws={"alpha": 0.5},
    line_kws={"color": ORANGE}
)

plt.title("Absences vs Final Grade")
plt.xlabel("Absences")
plt.ylabel("Final Grade")
plt.tight_layout()
plt.savefig("figures/absences_vs_grade.png", dpi=200)
plt.close()

# 6.4 Previous failures vs grades
plt.figure(figsize=(7, 4))
sns.barplot(x="failures", y="G3", data=df)

plt.title("Previous Failures vs Final Grade")
plt.xlabel("Previous Failures")
plt.ylabel("Average Grade")
plt.tight_layout()
plt.savefig("figures/failures_vs_grade.png", dpi=200)
plt.close()

# 6.5 Family support analysis
fig, ax = plt.subplots(1, 2, figsize=(9, 4))

sns.boxplot(x="famsup", y="G3", data=df, ax=ax[0])
ax[0].set_title("Family Support vs Grade")

rate = df.groupby("famsup")["target"].mean().reset_index()
rate["target"] *= 100

sns.barplot(x="famsup", y="target", data=rate, ax=ax[1])
ax[1].set_title("Needs Support Rate")
ax[1].set_ylabel("Percentage")

plt.tight_layout()
plt.savefig("figures/family_support.png", dpi=200)
plt.close()

# 6.6 Correlation heatmap
num_cols = df.select_dtypes(include=np.number).columns.drop("target")
corr = df[num_cols].corr()

plt.figure(figsize=(10, 8))
sns.heatmap(corr, annot=True, cmap="coolwarm", fmt=".2f")

plt.title("Correlation Heatmap")
plt.tight_layout()
plt.savefig("figures/correlation_heatmap.png", dpi=200)
plt.close()

print("\nCorrelation with final grade:")
print(corr["G3"].drop("G3").sort_values(ascending=False))

# 6.7 Pass vs Needs Support
plt.figure(figsize=(6, 4))

ax = sns.countplot(
    x="result", data=df,
    order=["Pass", "Needs Support"]
)

for p in ax.patches:
    ax.annotate(
        int(p.get_height()),
        (p.get_x() + p.get_width() / 2, p.get_height()),
        ha="center", va="bottom"
    )

plt.title("Pass vs Needs Support")
plt.xlabel("Result")
plt.ylabel("Number of Students")
plt.tight_layout()
plt.savefig("figures/class_distribution.png", dpi=200)
plt.close()

print("\nAll EDA graphs saved.")

# 7. Data preprocessing and encoding

cat_cols = df.drop(
    columns=["result", "target"]
).select_dtypes(exclude=np.number).columns.tolist()

print("\nCategorical columns:", cat_cols)

df_enc = pd.get_dummies(
    df.drop(columns=["result"]),
    columns=cat_cols,
    drop_first=True,
    dtype=int
)

print("Encoded dataset shape:", df_enc.shape)

# Model A: Early prediction without G1 and G2
X_all = df_enc.drop(
    columns=["G1", "G2", "G3", "target"]
)

# Model B: Prediction using G1 and G2
X_grades = df_enc.drop(
    columns=["G3", "target"]
)

y = df_enc["target"]

print("Model A features:", X_all.shape[1])
print("Model B features:", X_grades.shape[1])

# 8. Split dataset
X_train, X_test, y_train, y_test = train_test_split(
    X_all, y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

Xg_train, Xg_test, yg_train, yg_test = train_test_split(
    X_grades, y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

print("\nTraining samples:", len(X_train))
print("Testing samples:", len(X_test))

# 9. Train Random Forest models
rf = RandomForestClassifier(
    n_estimators=200,
    class_weight="balanced",
    random_state=42,
    n_jobs=-1
)

rf.fit(X_train, y_train)

rf_g = RandomForestClassifier(
    n_estimators=200,
    class_weight="balanced",
    random_state=42,
    n_jobs=-1
)

rf_g.fit(Xg_train, yg_train)

print("\nRandom Forest models trained successfully.")

# 10. Make predictions
y_pred = rf.predict(X_test)
y_pred_g = rf_g.predict(Xg_test)

comp = pd.DataFrame({
    "Actual": y_test.map({
        0: "Pass", 1: "Needs Support"
    }).to_numpy(),

    "Predicted": pd.Series(y_pred).map({
        0: "Pass", 1: "Needs Support"
    }).to_numpy()
})

print("\nFirst 10 predictions:")
print(comp.head(10))

# 11. Evaluate model
def evaluate(name, yt, yp):

    m = {
        "accuracy": accuracy_score(yt, yp),
        "precision": precision_score(
            yt, yp, zero_division=0
        ),
        "recall": recall_score(
            yt, yp, zero_division=0
        ),
        "f1": f1_score(
            yt, yp, zero_division=0
        )
    }

    cm = confusion_matrix(yt, yp, labels=[0, 1])

    print("\n", name)
    print("Accuracy :", round(m["accuracy"], 4))
    print("Precision:", round(m["precision"], 4))
    print("Recall   :", round(m["recall"], 4))
    print("F1 Score :", round(m["f1"], 4))

    print("\nConfusion Matrix:")
    print(cm)

    return m, cm


mA, cmA = evaluate(
    "MODEL A - Early Prediction",
    y_test, y_pred
)

print("\nClassification Report:")
print(classification_report(
    y_test, y_pred,
    labels=[0, 1],
    target_names=["Pass", "Needs Support"],
    zero_division=0
))

mB, cmB = evaluate(
    "MODEL B - With Previous Grades",
    yg_test, y_pred_g
)

# 12. Cross-validation
baseline = max(y_test.mean(), 1 - y_test.mean())

print("\nMajority Class Baseline:", round(baseline, 4))

skf = StratifiedKFold(
    n_splits=5,
    shuffle=True,
    random_state=42
)

cvA = cross_val_score(
    RandomForestClassifier(
        n_estimators=200,
        class_weight="balanced",
        random_state=42,
        n_jobs=-1
    ),
    X_all, y,
    cv=skf,
    scoring="accuracy"
)

cvB = cross_val_score(
    RandomForestClassifier(
        n_estimators=200,
        class_weight="balanced",
        random_state=42,
        n_jobs=-1
    ),
    X_grades, y,
    cv=skf,
    scoring="accuracy"
)

print("\nModel A CV scores:", cvA.round(3))
print("Model A Mean:", round(cvA.mean(), 4))

print("\nModel B CV scores:", cvB.round(3))
print("Model B Mean:", round(cvB.mean(), 4))

# 13. Confusion matrix visualization
fig, axes = plt.subplots(1, 2, figsize=(10, 4))

for ax, cm, title in zip(
    axes,
    [cmA, cmB],
    ["Model A", "Model B"]
):
    sns.heatmap(
        cm,
        annot=True,
        fmt="d",
        cmap="Blues",
        xticklabels=["Pass", "Needs Support"],
        yticklabels=["Pass", "Needs Support"],
        ax=ax
    )

    ax.set_title(title)
    ax.set_xlabel("Predicted")
    ax.set_ylabel("Actual")

plt.tight_layout()
plt.savefig("figures/confusion_matrix.png", dpi=200)
plt.close()

# 14. Feature importance
imp = pd.Series(
    rf.feature_importances_,
    index=X_all.columns
).sort_values(ascending=False)

print("\nTop 10 Important Features:")
print(imp.head(10).round(4))

top = imp.head(12).sort_values()

plt.figure(figsize=(8, 5))
plt.barh(top.index, top.values, color=BLUE)

plt.title("Feature Importance")
plt.xlabel("Importance")
plt.tight_layout()
plt.savefig("figures/feature_importance.png", dpi=200)
plt.close()

# 15. Predict a new student's performance

new_student = {
    "age": 17,
    "studytime": 1,
    "failures": 2,
    "absences": 14,
    "famsup": "no",
    "schoolsup": "no",
    "higher": "yes",
    "Medu": 2,
    "Fedu": 2,
    "goout": 4,
    "Walc": 3,
    "health": 3,
    "school": "GP",
    "sex": "M",
    "internet": "yes"
}

# Use median/mode values for remaining attributes
template = df.drop(
    columns=["result", "target", "G1", "G2", "G3"]
).iloc[[0]].copy()

for col in template.columns:
    if pd.api.types.is_numeric_dtype(df[col]):
        template[col] = df[col].median()
    else:
        template[col] = df[col].mode()[0]

for k, v in new_student.items():
    if k not in template.columns:
        raise ValueError(f"Unknown student feature: {k}")
    template.loc[:, k] = v

new_enc = pd.get_dummies(
    template,
    columns=[c for c in cat_cols if c in template.columns],
    drop_first=True,
    dtype=int
)

new_enc = new_enc.reindex(
    columns=X_all.columns,
    fill_value=0
)

label = rf.predict(new_enc)[0]
prob = rf.predict_proba(new_enc)[0]

print("\nNew Student Profile:")
print(new_student)

print("Predicted Result:",
      "Needs Support" if label == 1 else "Pass")

print("Pass Probability:", round(prob[0], 2))
print("Needs Support Probability:", round(prob[1], 2))

# 16. Second student prediction
good_student = dict(
    new_student,
    studytime=3,
    failures=0,
    absences=2,
    famsup="yes"
)

t2 = template.copy()

for k, v in good_student.items():
    t2.loc[:, k] = v

t2e = pd.get_dummies(
    t2,
    columns=[c for c in cat_cols if c in t2.columns],
    drop_first=True,
    dtype=int
)

t2e = t2e.reindex(
    columns=X_all.columns,
    fill_value=0
)

p2 = rf.predict_proba(t2e)[0]

print("\nSecond Student Prediction:")
print("Predicted Result:",
      "Needs Support" if rf.predict(t2e)[0] == 1 else "Pass")

print("Pass Probability:", round(p2[0], 2))
print("Needs Support Probability:", round(p2[1], 2))

# 17. Save results
RESULTS.update({
    "rows": int(df.shape[0]),
    "columns": int(df.shape[1]),
    "pass": int((y == 0).sum()),
    "support": int((y == 1).sum()),
    "train": int(len(X_train)),
    "test": int(len(X_test)),
    "model_A": {k: float(v) for k, v in mA.items()},
    "model_B": {k: float(v) for k, v in mB.items()},
    "confusion_matrix_A": cmA.tolist(),
    "confusion_matrix_B": cmB.tolist(),
    "baseline": float(baseline),
    "cvA": float(cvA.mean()),
    "cvB": float(cvB.mean()),
    "top_features": {
        k: float(v) for k, v in imp.head(12).items()
    },
    "new_student_probability": prob.tolist(),
    "new_student_label": int(label),
    "second_student_probability": p2.tolist(),
    "mean_grade": float(df["G3"].mean()),
    "std_grade": float(df["G3"].std())
})

with open("results.json", "w") as f:
    json.dump(RESULTS, f, indent=2)

print("\nAll results saved successfully.")
print("Graphs saved in figures folder.")
print("Execution completed successfully!")
